# ─────────────────────────────────────────────────────────────────────────────
# Tri-City Inator — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alpaca API (required) ─────────────────────────────────────────────────────
# Get these at https://alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# true  = paper trading (safe, uses fake money) ← START HERE
# false = live trading  (real money — use with extreme caution)
ALPACA_PAPER=true

# ── Risk Management ───────────────────────────────────────────────────────────
# % of account equity to risk per trade (1-2% recommended)
# RISK_PCT=2.0

# Stop loss % below entry price
# STOP_PCT=5.0

# Fixed dollar risk fallback if account equity unavailable
# FIXED_RISK=150

# Maximum concurrent open positions
# MAX_POSITIONS=3

# Maximum daily loss before trading stops (negative number)
# MAX_DAILY_LOSS=-300

# ── Opening Range Breakout (ORB) ─────────────────────────────────────────────
# Length of the opening range in minutes. Common choices:
#   5  = first 5-minute candle (fast, aggressive — good for high-momentum days)
#   15 = first 15-minute candle (default — most reliable, wider range)
#   30 = first 30-minute candle (conservative — best for slower, steadier movers)
#
# This setting controls:
#   - When the level lock fires (market open + ORB_MINUTES = level lock time)
#   - The ORH/ORL values saved to shared/tri-city-levels.json
#   - The Dr Heinz indicator on your TradingView chart must be set to the SAME
#     timeframe as ORB_MINUTES for levels to match
#
# ORB_MINUTES=15

# ── Entry Parameters ──────────────────────────────────────────────────────────
# Minimum relative volume for entry (1.5x = 50% above average)
# MIN_RVOL=1.5

# Minimum gap-up % from previous close
# MIN_GAP_PCT=3.0

# Minimum intraday move % from open (alternative to gap)
# MIN_FROM_OPEN_PCT=2.0

# RSI range for entry
# RSI_MIN=50
# RSI_MAX=75

# Maximum distance from 52-week high (%)
# MAX_52W_DIST=30.0

# No new entries after this time (CT)
# NO_ENTRY_HOUR=13
# NO_ENTRY_MINUTE=0

# ── Take Profit Targets ───────────────────────────────────────────────────────
# T1: sell 50% of position
# T1_PCT=10.0
# T2: sell 25% of position
# T2_PCT=20.0
# T3: trail remaining 25%
# T3_PCT=30.0

# ── Market Regime ─────────────────────────────────────────────────────────────
# Block LONG entries when SPY is down more than this %
# SPY_BEAR_THRESHOLD=-1.5

# ── EOD Close Time ────────────────────────────────────────────────────────────
# EOD_HOUR=15
# EOD_MINUTE=45

# ── Custom Strategy (advanced — optional) ─────────────────────────────────────
# Set CUSTOM_STRATEGY=true to use your own signal logic instead of Tri-City.
# Then set STRATEGY_FILE to the path of your strategy file (relative to the
# tri-city-inator folder). See strategies/custom_template.py to get started.
#
# CUSTOM_STRATEGY=false
# STRATEGY_FILE=strategies/my_orb_strategy.py
