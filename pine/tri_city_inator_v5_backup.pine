// This file is the canonical source for the Tri-City Inator Pine Script.
// Paste into TradingView Pine Editor → Save → Add to TRI CITY INATOR III layout.
// ─────────────────────────────────────────────────────────────────────────────
// v5 — inlined headers (no local fn inside if block), single-line request.security
// Input layout: in_0–in_1 Display, in_2–in_6 Scanner, in_7–in_21 Symbols (15 slots)
// Columns: SYMBOL · PRICE · RSI · EMA DEV% · RVOL · ORH/ORL · CUP · SMA↑ · 52H · HTF · SIGNAL
// ─────────────────────────────────────────────────────────────────────────────

//@version=5
indicator("Tri-City Inator - Breakout + Continuation Scanner", shorttitle="Tri-City", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ── Display inputs (in_0, in_1) ────────────────────────────────────────────────
i_size    = input.string("AUTO", "Table text size", options=["AUTO","SMALL","NORMAL","LARGE"], group="Display")
i_pos     = input.string("Bottom Right", "Table position", options=["Top Left","Top Right","Bottom Left","Bottom Right","Middle Left","Middle Right"], group="Display")

// ── Scanner inputs (in_2 … in_6) ──────────────────────────────────────────────
i_orb_min = input.int(5,     "ORB Minutes (5 / 15 / 30)", minval=1,   group="Scanner")
i_rsi_len = input.int(14,    "RSI Length",                minval=1,   group="Scanner")
i_ema_m   = input.int(21,    "EMA Mid",                   minval=1,   group="Scanner")
i_hi_vol  = input.float(1.5, "High-Vol RVol threshold",   minval=0.1, group="Scanner")
i_tf      = input.timeframe("5",  "Scanner timeframe",               group="Scanner")

// Compute how many bars of scanner-TF data equal one ORB window
// e.g. ORB_MINUTES=5, i_tf="5" → 1 bar; ORB_MINUTES=15, i_tf="5" → 3 bars
_tf_mins  = math.max(1.0, nz(str.tonumber(i_tf), 1.0))
_orb_bars = math.max(1, math.round(i_orb_min / _tf_mins))

// ── Symbol inputs (in_7 … in_21) ──────────────────────────────────────────────
sym1  = input.symbol("NASDAQ:RKLB", "Symbol 1",  group="Symbols")
sym2  = input.symbol("AMEX:AGQ",    "Symbol 2",  group="Symbols")
sym3  = input.symbol("NASDAQ:AEHR", "Symbol 3",  group="Symbols")
sym4  = input.symbol("NASDAQ:NBIS", "Symbol 4",  group="Symbols")
sym5  = input.symbol("NASDAQ:TSEM", "Symbol 5",  group="Symbols")
sym6  = input.symbol("NASDAQ:NEXT", "Symbol 6",  group="Symbols")
sym7  = input.symbol("NASDAQ:MRVL", "Symbol 7",  group="Symbols")
sym8  = input.symbol("NYSE:OXY",    "Symbol 8",  group="Symbols")
sym9  = input.symbol("NYSE:XOM",    "Symbol 9",  group="Symbols")
sym10 = input.symbol("NYSE:CVX",    "Symbol 10", group="Symbols")
sym11 = input.symbol("NASDAQ:NVDA", "Symbol 11", group="Symbols")
sym12 = input.symbol("NASDAQ:AMD",  "Symbol 12", group="Symbols")
sym13 = input.symbol("NASDAQ:META", "Symbol 13", group="Symbols")
sym14 = input.symbol("NASDAQ:AMZN", "Symbol 14", group="Symbols")
sym15 = input.symbol("NASDAQ:AAPL", "Symbol 15", group="Symbols")

// ── Helpers ───────────────────────────────────────────────────────────────────
f_tsize() =>
    i_size == "SMALL"  ? size.small  :
     i_size == "NORMAL" ? size.normal :
     i_size == "LARGE"  ? size.large  : size.auto

f_tpos() =>
    i_pos == "Top Left"     ? position.top_left    :
     i_pos == "Top Right"    ? position.top_right   :
     i_pos == "Bottom Left"  ? position.bottom_left :
     i_pos == "Middle Left"  ? position.middle_left :
     i_pos == "Middle Right" ? position.middle_right :
     position.bottom_right

_session_open = timestamp("America/Chicago", year, month, dayofmonth, 8, 30, 0)
_orb_close    = _session_open + i_orb_min * 60 * 1000

// ── get_signal ────────────────────────────────────────────────────────────────
// Returns: [price, rsi, ema_dev, orh, orl, cup, sig, rvol, sma_rising, near_52wk, htf]
get_signal(sym) =>
    [p, rsi_raw, ema_m_raw, vol_raw, avg_vol_raw, high_raw, low_raw, orb_hi_raw, orb_lo_raw] = request.security(sym, i_tf, [close, ta.rsi(close, i_rsi_len), ta.ema(close, i_ema_m), volume, ta.sma(volume, 10), high, low, ta.highest(high, _orb_bars), ta.lowest(low, _orb_bars)], lookahead=barmerge.lookahead_off)
    [sma50_d, sma100_d, hi52w_d, close65_d] = request.security(sym, "D", [ta.sma(close, 50), ta.sma(close, 100), ta.highest(close, 252), nz(close[65])], lookahead=barmerge.lookahead_off)
    rsi      = math.round(rsi_raw, 1)
    ema_dev  = math.round((p - ema_m_raw) / ema_m_raw * 100, 2)
    rel_vol  = avg_vol_raw > 0 ? vol_raw / avg_vol_raw : 1.0
    hi_vol   = rel_vol >= i_hi_vol
    _locked  = time >= _orb_close
    orh      = _locked ? orb_hi_raw : float(na)
    orl      = _locked ? orb_lo_raw : float(na)
    _h20     = ta.highest(high_raw, 20)
    _l20     = ta.lowest(low_raw,   20)
    cup      = _h20 > 0 and (_h20 - _l20) / _h20 < 0.06 and p >= _h20 * 0.99
    _above_orh = not na(orh) and p > orh
    sig =
         _above_orh and hi_vol and ema_dev > 0 and rsi > 50                          ? 1 :
         _above_orh and ema_dev >= 0 and ema_dev <= 1.0                               ? 2 :
         p > ema_m_raw and ema_dev >= 0 and ema_dev <= 0.8 and rsi >= 38 and rsi <= 55 and rsi > rsi[1] ? 3 : 0
    sma_rising = sma50_d > sma100_d and sma100_d > 0
    near_52wk  = hi52w_d > 0 and p / hi52w_d > 0.95
    htf_flag   = close65_d > 0 and (p - close65_d) / close65_d * 100 >= 90.0
    [p, rsi, ema_dev, nz(orh), nz(orl), cup ? 1 : 0, sig, math.round(rel_vol, 2), sma_rising ? 1 : 0, near_52wk ? 1 : 0, htf_flag ? 1 : 0]

// ── Fetch all 15 symbols ──────────────────────────────────────────────────────
[p1,  r1,  d1,  oh1,  ol1,  c1,  s1,  rv1,  sr1,  n1,  hf1]  = get_signal(sym1)
[p2,  r2,  d2,  oh2,  ol2,  c2,  s2,  rv2,  sr2,  n2,  hf2]  = get_signal(sym2)
[p3,  r3,  d3,  oh3,  ol3,  c3,  s3,  rv3,  sr3,  n3,  hf3]  = get_signal(sym3)
[p4,  r4,  d4,  oh4,  ol4,  c4,  s4,  rv4,  sr4,  n4,  hf4]  = get_signal(sym4)
[p5,  r5,  d5,  oh5,  ol5,  c5,  s5,  rv5,  sr5,  n5,  hf5]  = get_signal(sym5)
[p6,  r6,  d6,  oh6,  ol6,  c6,  s6,  rv6,  sr6,  n6,  hf6]  = get_signal(sym6)
[p7,  r7,  d7,  oh7,  ol7,  c7,  s7,  rv7,  sr7,  n7,  hf7]  = get_signal(sym7)
[p8,  r8,  d8,  oh8,  ol8,  c8,  s8,  rv8,  sr8,  n8,  hf8]  = get_signal(sym8)
[p9,  r9,  d9,  oh9,  ol9,  c9,  s9,  rv9,  sr9,  n9,  hf9]  = get_signal(sym9)
[p10, r10, d10, oh10, ol10, c10, s10, rv10, sr10, n10, hf10] = get_signal(sym10)
[p11, r11, d11, oh11, ol11, c11, s11, rv11, sr11, n11, hf11] = get_signal(sym11)
[p12, r12, d12, oh12, ol12, c12, s12, rv12, sr12, n12, hf12] = get_signal(sym12)
[p13, r13, d13, oh13, ol13, c13, s13, rv13, sr13, n13, hf13] = get_signal(sym13)
[p14, r14, d14, oh14, ol14, c14, s14, rv14, sr14, n14, hf14] = get_signal(sym14)
[p15, r15, d15, oh15, ol15, c15, s15, rv15, sr15, n15, hf15] = get_signal(sym15)

// ── Build arrays ──────────────────────────────────────────────────────────────
syms  = array.from(sym1,sym2,sym3,sym4,sym5,sym6,sym7,sym8,sym9,sym10,sym11,sym12,sym13,sym14,sym15)
prices= array.from(p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11,p12,p13,p14,p15)
rsis  = array.from(r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15)
devs  = array.from(d1,d2,d3,d4,d5,d6,d7,d8,d9,d10,d11,d12,d13,d14,d15)
orhs  = array.from(oh1,oh2,oh3,oh4,oh5,oh6,oh7,oh8,oh9,oh10,oh11,oh12,oh13,oh14,oh15)
orls  = array.from(ol1,ol2,ol3,ol4,ol5,ol6,ol7,ol8,ol9,ol10,ol11,ol12,ol13,ol14,ol15)
cups  = array.from(c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,c15)
sigs  = array.from(s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13,s14,s15)
rvols = array.from(rv1,rv2,rv3,rv4,rv5,rv6,rv7,rv8,rv9,rv10,rv11,rv12,rv13,rv14,rv15)
smars = array.from(sr1,sr2,sr3,sr4,sr5,sr6,sr7,sr8,sr9,sr10,sr11,sr12,sr13,sr14,sr15)
n52s  = array.from(n1,n2,n3,n4,n5,n6,n7,n8,n9,n10,n11,n12,n13,n14,n15)
htfs  = array.from(hf1,hf2,hf3,hf4,hf5,hf6,hf7,hf8,hf9,hf10,hf11,hf12,hf13,hf14,hf15)

// ── Colors ────────────────────────────────────────────────────────────────────
C_HDR  = color.new(#1a3a1a, 0)
C_BG   = color.new(#0d1117, 0)
C_ROW  = color.new(#111820, 0)
C_TXT  = color.new(color.white, 0)
C_DIM  = color.new(#888888, 0)
C_BRK  = color.new(#00c853, 0)
C_CONT = color.new(#0091ea, 0)
C_PULL = color.new(#ff6f00, 0)
C_CUP  = color.new(#ffd600, 0)
C_WARN = color.new(#ff9800, 0)
C_HTF  = color.new(#ffd600, 0)

// ── Table (11 cols × 17 rows) ─────────────────────────────────────────────────
if barstate.islast
    tbl = table.new(f_tpos(), 11, 17, bgcolor=C_BG, border_color=color.new(#333333,0), border_width=1)
    sz = f_tsize()
    table.cell(tbl, 0,  0, "SYMBOL",   text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 1,  0, "PRICE",    text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 2,  0, "RSI",      text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 3,  0, "EMA DEV%", text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 4,  0, "RVOL",     text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 5,  0, "ORH/ORL",  text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 6,  0, "CUP",      text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 7,  0, "SMA↑",     text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 8,  0, "52H",      text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 9,  0, "HTF",      text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    table.cell(tbl, 10, 0, "SIGNAL",   text_color=C_TXT, bgcolor=C_HDR, text_size=sz, text_halign=text.align_center)
    for i = 0 to 14
        row     = i + 1
        sym     = array.get(syms,  i)
        tick    = str.contains(sym, ":") ? str.substring(sym, str.pos(sym, ":") + 1, str.length(sym)) : sym
        p       = array.get(prices, i)
        rsi     = array.get(rsis,   i)
        dev     = array.get(devs,   i)
        orh     = array.get(orhs,   i)
        orl     = array.get(orls,   i)
        cup     = array.get(cups,   i)
        sig     = array.get(sigs,   i)
        rv      = array.get(rvols,  i)
        sr      = array.get(smars,  i)
        n52     = array.get(n52s,   i)
        hf      = array.get(htfs,   i)
        bg      = i % 2 == 0 ? C_ROW : C_BG
        sig_txt = sig == 1 ? "BREAKOUT" : sig == 2 ? "CONTINUATION" : sig == 3 ? "PULLBACK" : "---"
        sig_col = sig == 1 ? C_BRK : sig == 2 ? C_CONT : sig == 3 ? C_PULL : C_DIM
        cup_txt = cup == 1 ? "YES" : "---"
        cup_col = cup == 1 ? C_CUP : C_DIM
        orh_str = orh > 0 ? str.tostring(orh, "#.##") + " / " + str.tostring(orl, "#.##") : "---"
        dev_str = dev >= 0 ? "+" + str.tostring(dev, "#.##") : str.tostring(dev, "#.##")
        rv_str  = str.tostring(rv, "#.#") + "x"
        rv_col  = rv < 1.5 ? color.red : rv < 2.5 ? C_CUP : C_BRK
        sr_txt  = sr == 1 ? "Y" : "-"
        sr_col  = sr == 1 ? C_BRK : C_DIM
        n52_txt = n52 == 1 ? "⚠" : "-"
        n52_col = n52 == 1 ? C_WARN : C_DIM
        hf_txt  = hf == 1 ? "★" : "-"
        hf_col  = hf == 1 ? C_HTF : C_DIM
        table.cell(tbl, 0,  row, tick,                    text_color=C_TXT,  bgcolor=bg, text_size=sz, text_halign=text.align_left)
        table.cell(tbl, 1,  row, str.tostring(p,"#.##"),  text_color=C_TXT,  bgcolor=bg, text_size=sz, text_halign=text.align_right)
        table.cell(tbl, 2,  row, str.tostring(rsi,"#.#"), text_color=C_TXT,  bgcolor=bg, text_size=sz, text_halign=text.align_right)
        table.cell(tbl, 3,  row, dev_str,                 text_color=C_TXT,  bgcolor=bg, text_size=sz, text_halign=text.align_right)
        table.cell(tbl, 4,  row, rv_str,                  text_color=rv_col, bgcolor=bg, text_size=sz, text_halign=text.align_right)
        table.cell(tbl, 5,  row, orh_str,                 text_color=C_DIM,  bgcolor=bg, text_size=sz, text_halign=text.align_center)
        table.cell(tbl, 6,  row, cup_txt,                 text_color=cup_col,bgcolor=bg, text_size=sz, text_halign=text.align_center)
        table.cell(tbl, 7,  row, sr_txt,                  text_color=sr_col, bgcolor=bg, text_size=sz, text_halign=text.align_center)
        table.cell(tbl, 8,  row, n52_txt,                 text_color=n52_col,bgcolor=bg, text_size=sz, text_halign=text.align_center)
        table.cell(tbl, 9,  row, hf_txt,                  text_color=hf_col, bgcolor=bg, text_size=sz, text_halign=text.align_center)
        table.cell(tbl, 10, row, sig_txt,                 text_color=sig_col,bgcolor=bg, text_size=sz, text_halign=text.align_center)

// ── Alerts ────────────────────────────────────────────────────────────────────
_any_breakout     = s1==1 or s2==1 or s3==1 or s4==1 or s5==1 or s6==1 or s7==1 or s8==1 or s9==1 or s10==1 or s11==1 or s12==1 or s13==1 or s14==1 or s15==1
_any_continuation = s1==2 or s2==2 or s3==2 or s4==2 or s5==2 or s6==2 or s7==2 or s8==2 or s9==2 or s10==2 or s11==2 or s12==2 or s13==2 or s14==2 or s15==2
_any_pullback     = s1==3 or s2==3 or s3==3 or s4==3 or s5==3 or s6==3 or s7==3 or s8==3 or s9==3 or s10==3 or s11==3 or s12==3 or s13==3 or s14==3 or s15==3
_cup_breakout     = (s1==1 and c1==1) or (s2==1 and c2==1) or (s3==1 and c3==1) or (s4==1 and c4==1) or (s5==1 and c5==1) or (s6==1 and c6==1) or (s7==1 and c7==1) or (s8==1 and c8==1) or (s9==1 and c9==1) or (s10==1 and c10==1) or (s11==1 and c11==1) or (s12==1 and c12==1) or (s13==1 and c13==1) or (s14==1 and c14==1) or (s15==1 and c15==1)

alertcondition(_any_breakout,     "Breakout Signal",      "Tri-City: BREAKOUT detected")
alertcondition(_any_continuation, "Continuation Signal",  "Tri-City: CONTINUATION detected")
alertcondition(_any_pullback,     "Pullback Signal",       "Tri-City: PULLBACK detected")
alertcondition(_cup_breakout,     "Breakout + Cup COMBO", "Tri-City: BREAKOUT + CUP")
alertcondition(_any_breakout or _any_continuation or _any_pullback, "Any Signal", "Tri-City: Signal detected")
